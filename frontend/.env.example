# Leave unset for local dev — Vite's dev server proxies /api and /uploads to
# http://localhost:5000 (see vite.config.js), so no config is needed.
#
# For a production build where the frontend and backend are on different
# origins (e.g. frontend on Vercel/Netlify, backend on Render/Railway), set
# this to your backend's full URL:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=
