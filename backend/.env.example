# ---- Core ----
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rakhi_store
# Comma-separated list if you need to allow more than one origin, e.g. a
# separate admin subdomain: https://rakhi-store.com,https://admin.rakhi-store.com
CLIENT_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- First admin account (used by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=admin@rakhi.com
SEED_ADMIN_PASSWORD=Admin@123

# ---- Outbound email (optional — order invoice emails silently no-op if unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- File storage (optional — defaults to local disk under backend/uploads) ----
# Set these to switch to S3-compatible storage instead. Works with real AWS S3,
# and with any S3-compatible provider (Cloudflare R2, DigitalOcean Spaces,
# MinIO, Backblaze B2) by also setting S3_ENDPOINT.
# Strongly recommended for production on most PaaS hosts — see the
# deployment section of README.md for why local disk usually isn't enough.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACL=public-read
S3_PUBLIC_URL_BASE=
